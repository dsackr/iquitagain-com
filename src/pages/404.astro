---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found — I Quit... Again!">
  <div class="text-center py-20">
    <h1 class="text-6xl font-extrabold text-emerald-600 dark:text-emerald-400">404</h1>
    <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100 mt-4">Page Not Found</h2>
    <p class="text-zinc-600 dark:text-zinc-400 mt-2">The page you're looking for doesn't exist or has moved.</p>
    <div class="mt-8">
      <a href="/" class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold transition-colors">
        Return Home
      </a>
    </div>
  </div>
</BaseLayout>
